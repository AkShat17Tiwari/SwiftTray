# SwiftTray environment configuration
# Copy browser-facing values to .env.local. Keep secrets in Convex.

# Convex development deployment
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth — set these on the Convex deployment:
# npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
# npx convex env set SITE_URL http://localhost:3000
# Comma-separated accounts that receive administrator access:
# npx convex env set ADMIN_EMAILS admin@example.com
# Secret pepper used to hash vendor login codes:
# openssl rand -hex 32 | npx convex env set PORTAL_CODE_PEPPER

# Razorpay — set these on the Convex deployment, never in browser env files:
# npx convex env set RAZORPAY_KEY_ID rzp_test_...
# npx convex env set RAZORPAY_KEY_SECRET <secret>
# npx convex env set RAZORPAY_WEBHOOK_SECRET <32-plus-character-secret>
#
# Configure this endpoint in Razorpay for payment.authorized,
# payment.captured, payment.failed, and refund.processed:
# https://your-deployment.convex.site/razorpay/webhook
